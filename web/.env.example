# Copy to .env and adjust. SQLite file lives next to the schema.
DATABASE_URL="file:./dev.db"

# Generate a strong value, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"

# Public URL of the app.
#   local dev (npm run dev, port 3333): http://localhost:3333
#   Windows servisi (next start, 3000): http://localhost:3000
#   production: https://sobso.net   (must match the domain Nginx serves)
NEXTAUTH_URL="http://localhost:3333"

# --- Production (behind Nginx) ---
# Bind only to loopback so the app is reachable solely through Nginx:
# HOST=127.0.0.1
# PORT=3000
# Where receipt photos are stored (default: <app>/data/receipts):
# DEFTER_UPLOAD_DIR=/www/sobso-data/receipts

# Yönetim paneli (/admin) erişimi olan TEK kullanıcı adı. Güvenlik gereği
# admin kimliği kodda tutulmaz; her ortamda buraya kendin yazarsın.
# Boş bırakılırsa hiç kimse admin olamaz.
ADMIN_USERNAME=""

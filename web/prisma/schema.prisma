// Defter — data model (SQLite via Prisma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String?
  passwordHash String
  createdAt    DateTime @default(now())

  // Required for new sign-ups (existing accounts add it from the profile).
  // emailVerified will be set once the e-mail OTP flow ships.
  email         String?   @unique
  emailVerified DateTime?

  // Payment details for settlements (IBAN / QR).
  iban     String?
  ibanName String?

  memberships     GroupMember[]
  paidExpenses    Expense[]      @relation("Payer")
  shares          ExpenseShare[]
  settlementsFrom Settlement[]   @relation("SettlementFrom")
  settlementsTo   Settlement[]   @relation("SettlementTo")
  activities      Activity[]     @relation("ActivityActor")
  notifications   Notification[]
}

// In-app notification (push delivery will reuse these rows later).
model Notification {
  id        String    @id @default(cuid())
  userId    String // recipient
  type      String // "expense.add" | "settle" | "member.add" | "payment.reminder" | "payment.due" | ...
  title     String
  body      String?
  groupId   String? // deep-link target, if any
  meta      String? // optional JSON (rate-limit keys etc.)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("Tatil") // "Tatil" | "Kisisel" (kişisel bütçe)
  currency    String   @default("TRY")
  createdById String
  createdAt   DateTime @default(now())

  // Optional monthly spending budget for the group.
  monthlyBudget Float?

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invites     Invite[]
  activities  Activity[]
  recurring   RecurringExpense[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  // Ownership ratio for "Girisim" (venture) groups. Null => treated as equal.
  shareRatio Float?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String
  payerId     String
  amount      Float // amount in the group's currency
  description String
  category    String?
  date        DateTime @default(now())
  kind        String   @default("expense") // "expense" | "income" (income: personal budget only)
  splitType   String   @default("Equal") // "Equal" | "Exact"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Receipt photo (stored on disk, served via authenticated API route).
  receiptPath String?

  // Multi-currency: what was originally entered, converted to group currency.
  originalAmount   Float?
  originalCurrency String?
  fxRate           Float? // multiply original by this to get group currency

  // Link back to the recurring template that produced this expense, if any.
  recurringId String?

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("Payer", fields: [payerId], references: [id])
  shares ExpenseShare[]
}

model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

// A confirmed payment from a debtor to a creditor. Recording one reduces the
// outstanding debt in the balance math. Only the creditor (toUser) may create
// or undo it.
model Settlement {
  id            String   @id @default(cuid())
  groupId       String
  fromUserId    String // debtor who pays
  toUserId      String // creditor who receives + confirms
  amount        Float
  method        String? // "IBAN" | "Nakit" | "Diğer"
  note          String?
  confirmedById String // who marked it paid — always the creditor (toUserId)
  createdAt     DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId])
}

// Group activity feed + audit log (one row per meaningful action).
model Activity {
  id        String   @id @default(cuid())
  groupId   String
  actorId   String
  type      String // "expense.add" | "expense.edit" | "expense.delete" | "settle" | "unsettle" | "member.add" | "member.join" | "group.create" | "budget.set" | "recurring.add" | "recurring.run"
  summary   String
  meta      String? // optional JSON payload
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User  @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([groupId, createdAt])
}

// Shareable invite link to join a group without knowing the exact username.
model Invite {
  id          String    @id @default(cuid())
  groupId     String
  token       String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  active      Boolean   @default(true)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Template for a recurring expense; occurrences are materialized lazily.
model RecurringExpense {
  id             String   @id @default(cuid())
  groupId        String
  description    String
  category       String?
  amount         Float
  payerId        String
  splitType      String   @default("Equal")
  participantIds String // JSON array of userIds
  interval       String // "weekly" | "monthly"
  nextRunAt      DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

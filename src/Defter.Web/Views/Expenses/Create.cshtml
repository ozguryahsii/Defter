@model CreateExpenseViewModel
@{
    ViewData["Title"] = "Harcama Ekle";
}
<div class="card">
    <h1>Harcama Ekle · @Model.GroupName</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="validation"></div>
        <input type="hidden" asp-for="GroupId" />

        <div class="form-row">
            <div>
                <label asp-for="Description"></label>
                <input asp-for="Description" autofocus placeholder="Örn. Akşam yemeği" />
            </div>
            <div>
                <label asp-for="Category"></label>
                <input asp-for="Category" placeholder="Örn. Yemek" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="Amount"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" /> <span class="cur">@Model.Currency</span>
            </div>
            <div>
                <label asp-for="Date"></label>
                <input asp-for="Date" type="date" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label asp-for="PayerUserId">Ödeyen</label>
                <select asp-for="PayerUserId">
                    @foreach (var m in Model.Members)
                    {
                        <option value="@m.UserId">@m.UserName</option>
                    }
                </select>
            </div>
            <div>
                <label asp-for="SplitType">Bölüşüm</label>
                <select asp-for="SplitType" id="splitType">
                    <option value="0">Eşit böl</option>
                    <option value="1">Özel tutarlar</option>
                </select>
            </div>
        </div>

        <fieldset class="participants">
            <legend>Kimleri kapsıyor?</legend>
            <table class="table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Üye</th>
                        <th data-exact-cell class="r">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Members)
                {
                    var isChecked = Model.SelectedParticipantIds.Contains(m.UserId);
                    <tr class="participant-row">
                        <td>
                            <input type="checkbox" name="SelectedParticipantIds" value="@m.UserId"
                                   id="p_@m.UserId" @(isChecked ? "checked" : "") />
                        </td>
                        <td><label for="p_@m.UserId">@m.UserName</label></td>
                        <td data-exact-cell class="r">
                            <input class="exact-input" type="number" step="0.01" min="0"
                                   name="ExactAmounts[@m.UserId]" placeholder="0.00" />
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="muted small">
                “Eşit böl” seçiliyken tutar seçili kişilere eşit paylaştırılır (kuruş farkı adil dağıtılır).
                “Özel tutarlar”da girdiğin payların toplamı tutara eşit olmalıdır.
            </p>
        </fieldset>

        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-controller="Groups" asp-action="Details" asp-route-id="@Model.GroupId" class="btn">Vazgeç</a>
    </form>
</div>
